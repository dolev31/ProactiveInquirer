# Copy to .env and fill in. .env is git-ignored. Load it with:  set -a; . ./.env; set +a
# The client refuses to default a model pin, so every role you run needs one.

# Any OpenAI-compatible endpoint LiteLLM can reach.
LITELLM_BASE_URL=https://litellm.example.com
LITELLM_API_KEY=

# One model pin per role.
PI_MODEL_INQUIRER=
PI_MODEL_DRAFTER=
PI_MODEL_ANSWERER=
PI_MODEL_USERSIM=
PI_MODEL_JUDGE=

# Cost accounting. The 2026-09 table also prices locally served adapters.
PI_PRICE_TABLE=scripts/price_tables/2026-09.json

# Scoring reads the gold graphs from here. Rollout workers must run with it UNSET (the firewall).
# PI_GOLD_ROOT=data/gold

# Optional overrides of where runs and the response cache live.
# PI_RUNS_ROOT=runs
# PI_CACHE_ROOT=cache

# Needed only by the suites that use them.
TAU2_DATA_DIR=
HF_TOKEN=
DRGYM_API_KEY=
# Second gateway key, read by scripts/tau2_campaign/proxy_up.sh.
PI_AGENT_LITELLM_API_KEY=
